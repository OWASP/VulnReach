# Test/runtime image: builder toolchain + python3 + docker CLI, for running the
# P0 acceptance test in a node-agent-style container (--privileged --pid=host
# --cgroupns=host, docker socket mounted).
FROM vulnreach-observer-build

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 \
      python3-pip \
      python3-pytest \
      docker.io \
  && rm -rf /var/lib/apt/lists/*

# core.models (ReachabilityFinding) needs pydantic for the P5 verdict integration.
RUN pip install --no-cache-dir --break-system-packages pydantic
