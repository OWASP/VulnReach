# Copy this file to .env.local and fill in every CHANGE_ME value before running.
# .env.local is gitignored — never commit it.
#
# Generate strong secrets with:
#   openssl rand -hex 32

# ── Postgres ───────────────────────────────────────────────────────────────────
POSTGRES_DB=vulnreach
POSTGRES_USER=vulnreach
POSTGRES_PASSWORD=CHANGE_ME

# Used by the app to connect to the bundled postgres service.
DATABASE_URL=postgresql://vulnreach:CHANGE_ME@db:5432/vulnreach

# ── Auth ───────────────────────────────────────────────────────────────────────
# Secret key used to sign JWT tokens — must match across all app instances.
# At least 32 bytes; the server refuses to issue or verify tokens otherwise.
JWT_SECRET=CHANGE_ME

# ── Initial admin account ──────────────────────────────────────────────────────
# Created on first startup if no users exist. Change the password immediately.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME

# ── LLM Providers (optional) ──────────────────────────────────────────────────
# Required only for AI-assisted explanation / DAST features.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# For local inference via Ollama:
# VULNREACH_OLLAMA_URL=http://host.docker.internal:11434

# ── CORS (optional) ────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for cross-origin requests.
# Leave unset to block all cross-origin access (recommended for production).
# CORS_ORIGINS=https://your-dashboard.example.com

# ── Work Directory (optional) ─────────────────────────────────────────────────
# Set automatically by docker-compose.yml. Only override when running outside Docker.
# VULNREACH_WORK_DIR=/tmp/vulnreach

# ── Dynamic Runtime Opt-In (optional, high privilege) ─────────────────────────
# Dynamic reachability requires container-runtime access. Keep disabled unless needed.
# VULNREACH_ALLOW_DOCKER_DAEMON=false

# ── Experimental Runtime Tracing (optional) ────────────────────────────────────
# eBPF mode requires explicit opt-in and elevated privileges.
# VULNREACH_ALLOW_EBPF=false
